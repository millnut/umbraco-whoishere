<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Package: any Umbraco 18.x -->
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="[18.0.0, 19.0.0)" />

    <!-- Test site -->
    <PackageVersion Include="Umbraco.Cms" Version="[18.0.0, 19.0.0)" />
    <PackageVersion Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />

    <!-- Unit tests -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

</Project>
